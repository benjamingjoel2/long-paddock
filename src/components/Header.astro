---
import { CATEGORIES, SITE } from '../data/site';
const path = Astro.url.pathname;
const items = [...CATEGORIES.map((c) => ({ name: c.name, href: c.href })), { name: 'About', href: '/about/' }];
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href="/" aria-label={`${SITE.name}, home`}>
      <span class="wordmark-name">Long Paddock</span>
      <span class="wordmark-sub">Australia, by Tourground</span>
    </a>
  </div>
  <nav class="primary-nav" aria-label="Main">
    <ul class="wrap">
      {items.map((i) => (
        <li><a href={i.href} aria-current={path.startsWith(i.href) ? 'page' : undefined}>{i.name}</a></li>
      ))}
    </ul>
  </nav>
</header>
